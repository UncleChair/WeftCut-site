# dependencies (harness symlinks to the WeftCut repo's node_modules)
node_modules

# macOS
.DS_Store

# deploy bundle, assembled by build-dist.mjs on every deploy
dist/

# wrangler's local state (build cache, dev-server scratch)
.wrangler/

# scratch, regenerated on demand:
# - design-review screenshots from verification runs
.work/review*/
# - WeftCut project files; every harness script recreates them at run start
.work/projects/
# - upstream Maple Mono CN TTFs (~88 MB); fonts.py re-downloads them on demand
.work/fonts/
