{
  // WeftCut site — Cloudflare Workers deploy config (static assets + one hook).
  //
  // Cloudflare serves dist/ straight from its edge. Directory URLs resolve to
  // index.html, which is what /zh/ relies on.
  //
  //   npm run deploy      build dist/ and publish
  //   npm run preview     serve dist/ through the local Workers runtime
  "name": "weftcut-site",
  "compatibility_date": "2026-08-05",
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // --- why this list is short --------------------------------------------
    // The Worker answers `Accept: text/markdown` with a Markdown copy of the
    // page (worker.js). Doing that means running code on the request, and code
    // on a request bills against the Workers quota where a plain asset hit does
    // not. So it runs first on the two HTML routes only: every image, font and
    // video — which is essentially all the traffic, the videos alone dwarfing
    // the markup — still bypasses the Worker entirely.
    //
    // /zh with no trailing slash is deliberately absent: the assets host
    // redirects it to /zh/, and that second request lands here.
    "run_worker_first": [
      "/",
      "/index.html",
      "/zh/",
      "/zh/index.html"
    ]
  }

  // --- custom domain ---------------------------------------------------------
  // Cloudflare creates and owns the apex DNS record for a custom_domain route.
  // Never add an A/AAAA record for weftcut.com by hand: a pre-existing one makes
  // this deploy fail on a name collision, which is what Dynadot's imported
  // parking records (185.53.179.128) did until they were deleted.
  //
  // www is deliberately NOT bound here. It redirects to the apex via a Redirect
  // Rule in the dashboard; binding it would serve the site there instead.
  ,"routes": [
    { "pattern": "weftcut.com", "custom_domain": true }
  ]
}
