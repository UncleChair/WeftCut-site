# --- media types the assets host can't infer ---------------------------------
# /.well-known/api-catalog has no extension by design (RFC 9727 fixes the path),
# so its type has to be declared here or it ships as octet-stream. The .json
# documents next to it infer correctly on their own and are deliberately left
# alone — declaring them again here would append a second Content-Type.
/.well-known/api-catalog
  Content-Type: application/linkset+json; charset=utf-8

/.well-known/agent-skills/:skill/SKILL.md
  Content-Type: text/markdown; charset=utf-8

/assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
